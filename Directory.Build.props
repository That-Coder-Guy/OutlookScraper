<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- ICU is required: EventTimeResolver looks up IANA zone ids, and the Outlook
         Restrict filter has to format dates in en-US regardless of machine locale. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <Version>0.1.0</Version>
    <Authors>That-Coder-Guy</Authors>
    <Product>OutlookScraper</Product>
  </PropertyGroup>

  <!--
    Lets a non-Windows machine *restore* the Windows-targeted projects. Building them
    still requires Windows — WPF cannot compile here — but restore is enough to catch
    package-resolution problems (NU1605 downgrades, NU1701 framework fallbacks) without
    a round trip through CI. Exactly that class of bug broke the first windows-latest
    build, and it is reproducible locally with:

        dotnet restore OutlookScraper.sln

    No effect on Windows.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
