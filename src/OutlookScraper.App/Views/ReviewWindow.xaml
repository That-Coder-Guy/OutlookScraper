<Window x:Class="OutlookScraper.App.Views.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OutlookScraper.App.Views"
        Title="OutlookScraper — free food on campus"
        Height="620" Width="960"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:StringPresentToVisibilityConverter x:Key="StringPresentToVisibility" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="110" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Shared row template: the suppressed tab reuses it, minus the actions. -->
        <DataTemplate x:Key="SuggestionRow">
            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding When}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SuppressionDetail}" Style="{StaticResource Caption}"
                               Foreground="#A15" TextWrapping="Wrap"
                               Visibility="{Binding SuppressionDetail,
                                            Converter={StaticResource StringPresentToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <TabItem Header="Pending">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Pending}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemTemplate="{StaticResource SuggestionRow}"
                             HorizontalContentAlignment="Stretch" />

                    <TextBlock Grid.Column="0"
                               Text="{Binding EmptyMessage}"
                               TextWrapping="Wrap" Margin="16" VerticalAlignment="Center"
                               Foreground="#777"
                               Visibility="{Binding HasPending,
                                            Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- Detail pane: the source email is shown so the user can sanity-check
                         what the model actually read before booking anything. -->
                    <ScrollViewer Grid.Column="1" Margin="12,0,0,0"
                                  DataContext="{Binding Selected}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <Border Background="#FFF4CE" BorderBrush="#E8C86B" BorderThickness="1"
                                    Padding="8" Margin="0,8,0,0" CornerRadius="3"
                                    Visibility="{Binding NeedsDateReview,
                                                 Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DateWarning}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding When}" Margin="0,10,0,0" FontSize="14" />
                            <TextBlock Text="{Binding Location}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Food}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Organization}" Margin="0,2,0,0" />

                            <Separator Margin="0,12" />

                            <TextBlock Text="{Binding Sender}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Subject}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{Binding BodyExcerpt}" />

                            <Separator Margin="0,12" />

                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                <Run Text="Topic tag:" />
                                <Run Text="{Binding TopicTag, Mode=OneWay}" FontFamily="Consolas" />
                                <Run Text=" · " />
                                <Run Text="{Binding Category, Mode=OneWay}" FontFamily="Consolas" />
                            </TextBlock>
                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Everything the blacklist hid. This tab is the safety net that makes
                 semantic suppression acceptable: nothing disappears silently. -->
            <TabItem Header="Suppressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="8" TextWrapping="Wrap" Foreground="#777"
                               Text="Events hidden by your blacklist rules. If something here is not
                                     actually the same kind of event, restore it and that rule will
                                     stop matching it." />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Suppressed}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemTemplate="{StaticResource SuggestionRow}"
                             HorizontalContentAlignment="Stretch" />
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" Foreground="#444" />

            <Button DockPanel.Dock="Right" Content="Dismiss"
                    Command="{Binding DismissCommand}" CommandParameter="{Binding Selected}" />
            <Button DockPanel.Dock="Right" Content="Blacklist"
                    Command="{Binding BlacklistCommand}" CommandParameter="{Binding Selected}" />
            <Button DockPanel.Dock="Right" Content="Restore"
                    Command="{Binding RescueCommand}" CommandParameter="{Binding Selected}" />
            <Button DockPanel.Dock="Right" Content="Add to Calendar" IsDefault="True"
                    Command="{Binding AddCommand}" CommandParameter="{Binding Selected}" />
        </DockPanel>
    </Grid>
</Window>
