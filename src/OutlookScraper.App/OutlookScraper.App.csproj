<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!--
      The platform version is dictated by CommunityToolkit.WinUI.Notifications 7.1.2.
      Its assets split like this:

        lib/net5.0-windows10.0.18362  ToastNotificationManagerCompat  present
        lib/net5.0                    ToastNotificationManagerCompat  MISSING

      Below 10.0.18362 NuGet resolves the plain net5.0 asset, which has the toast
      builder but not the unpackaged COM activator — so the project would fail to
      compile the activation path. 19041 (Windows 10 2004) is the usual modern
      baseline and sits comfortably above the floor.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <UseWPF>true</UseWPF>
    <RootNamespace>OutlookScraper.App</RootNamespace>
    <AssemblyName>OutlookScraper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>tray.ico</ApplicationIcon>

    <!-- Tray app: never flash a console window. -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the tray icon works from a single published folder. -->
    <Resource Include="tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OutlookScraper.Core/OutlookScraper.Core.csproj" />
    <ProjectReference Include="../OutlookScraper.Outlook/OutlookScraper.Outlook.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Formally superseded by Microsoft.Windows.AppNotifications (Windows App SDK),
      but 7.1.2 is what still works for an unpackaged WPF app without dragging in
      the whole App SDK. All toast construction is isolated behind INotifier so
      swapping it later is one file.
    -->
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />

    <!--
      PINNED BELOW LATEST ON PURPOSE — do not bump to 2.4.x without checking assets.
      2.4.1 ships only `net10.0-windows7.0` and `net462`, so a .NET 8 project silently
      falls back to the .NET *Framework* build of a WPF control library. 2.3.2 is the
      newest release carrying a real `net8.0-windows7.0` asset.
    -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />

    <!-- SystemIcons/Icon interop for the notification-area handle. Windows-only,
         which this project already is. 9.0.1 is the floor required by
         H.GeneratedIcons.System.Drawing, which H.NotifyIcon pulls in. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.1" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!--
      Explicit rather than transitive: DpapiDataStore has to serialize exactly what
      Google's own FileDataStore does, and that contract is Newtonsoft-based.
      13.0.4 is the floor required by Google.Apis.Core.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <!--
      Held at 8.x deliberately. 9.0.0 requires Microsoft.Extensions.Logging 9.0.0,
      which would drag the whole Microsoft.Extensions graph a framework generation
      ahead of this net8.0 app for no benefit.
    -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

</Project>
