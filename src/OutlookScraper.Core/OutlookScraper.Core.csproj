<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately plain `net8.0`, NOT net8.0-windows.

    Every piece of logic worth testing lives in this project, and keeping the TFM
    Windows-free makes the compiler enforce that separation for free: if someone
    reaches for a COM type, WPF, the registry, or DPAPI in here, the build breaks.
    That is what lets the whole pipeline be unit-tested on Linux CI.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OutlookScraper.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
